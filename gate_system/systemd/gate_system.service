[Unit]
Description=Gate System - автоматическое открытие ворот по номеру
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/gate_system
ExecStart=/home/pi/gate_system/.venv/bin/python main.py
Restart=always
RestartSec=3
# Перезапуск даже при повторяющихся падениях (устойчивость 24/7)
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
